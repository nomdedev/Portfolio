{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "canva": {
      "type": "remote",
      "url": "https://mcp.canva.com/mcp"
    },
    "higgsfield": {
      "type": "remote",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{env:GOOGLE_API_KEY}"
      }
    }
  }
}
